{
  "commands": [
    {
      "name": "🚀 Start (server + Figma)",
      "command": "./start.sh",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "▶ Ingest server",
      "command": "npm run server",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "🔨 Build plugin",
      "command": "npm run build:plugin",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "🔐 Accept certificate (web Figma)",
      "command": "xdg-open https://localhost:8972/ping",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "⇄ Shared modules",
      "command": "npm run modules -- --shared",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "🧩 Chrome extensions",
      "command": "xdg-open chrome://extensions",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "🔍 QA: home desktop",
      "command": "npm run qa -- --page home --viewport desktop",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "🔍 QA: all pages",
      "command": "npm run qa:all",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "🔗 Automap: home",
      "command": "npm run automap -- --page home --viewport desktop",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "🩹 CSS patch: home",
      "command": "npm run patch -- --page home --viewport desktop",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "🔌 MCP: connect to Claude",
      "command": "claude mcp add pixel-guard -- node $(pwd)/server/mcp.mjs",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "🖼 Export block PNGs",
      "command": "npm run shots",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "🔎 Verify maps",
      "command": "npm run verify -- --fix",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "📖 Sync docs → GitHub Wiki",
      "command": "./wiki-sync.sh",
      "type": "terminal",
      "group": "pixel-guard"
    },
    {
      "name": "🔁 Remap: page → new frame",
      "command": "npm run remap -- --page home --from OLD:ID --to NEW:ID",
      "type": "terminal",
      "group": "pixel-guard"
    }
  ]
}
