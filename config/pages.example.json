{
  "home": {
    "url": "https://example.com/",
    "frames": {
      "desktop": null,
      "tablet": null,
      "mobile": null
    },
    "match": [
      "/"
    ]
  },
  "product": {
    "url": "https://example.com/product/example-item/",
    "match": [
      "/product/*"
    ],
    "frames": {
      "desktop": null,
      "tablet": null,
      "mobile": null
    }
  },
  "product-reviews": {
    "_comment": "virtual page: an AJAX tab measured on the product URL against the reviews component frame; prepare[] runs before the measurement. Add \"anywhere\": true for modals reachable from every page (header buttons) — the extension then offers this design on any URL",
    "url": "https://example.com/product/example-item/",
    "frames": {
      "desktop": null,
      "tablet": null,
      "mobile": null
    },
    "prepare": [
      {
        "click": "#tab-reviews"
      },
      {
        "waitFor": ".reviews-panel"
      }
    ],
    "match": []
  },
  "app-dashboard": {
    "_comment": "React / SPA: wait for the network to settle and for the root content to render before measuring",
    "url": "http://localhost:5173/dashboard",
    "frames": {
      "desktop": null,
      "tablet": null,
      "mobile": null
    },
    "spa": true,
    "ready": "#root [data-testid=dashboard]",
    "match": [
      "/dashboard"
    ]
  }
}
